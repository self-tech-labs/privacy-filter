{
  "name": "ogram-private",
  "private": true,
  "version": "0.1.2",
  "description": "Privacy Filter by ogram is a local-first desktop redaction tool for Swiss privacy-sensitive professionals.",
  "license": "MIT",
  "homepage": "https://self-tech-labs.github.io/privacy-filter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/self-tech-labs/privacy-filter.git"
  },
  "bugs": {
    "url": "https://github.com/self-tech-labs/privacy-filter/issues"
  },
  "type": "module",
  "scripts": {
    "app:dev": "vite --host 0.0.0.0 --port 1420 --strictPort",
    "app:build": "tsc -b && vite build",
    "app:preview": "vite preview",
    "dev": "npm run app:dev",
    "build": "npm run app:build",
    "lint": "eslint .",
    "preview": "npm run app:preview",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "vite build --config vite.site.config.ts",
    "site:preview": "npm run site:build && node scripts/preview-site.mjs",
    "site:check": "npm run site:build && node scripts/check-site-build.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri:dev": "npm run desktop:dev",
    "tauri:build": "npm run desktop:build",
    "test": "vitest run",
    "check": "npm test && npm run build && npm run site:check && cargo +1.88.0 check --manifest-path src-tauri/Cargo.toml",
    "release:mac:app": "node scripts/release/build-macos.mjs app",
    "release:mac:dmg": "node scripts/release/build-macos.mjs dmg",
    "release:mac:all": "node scripts/release/build-macos.mjs all",
    "release:mac:manifest": "node scripts/release/build-macos.mjs manifest",
    "release:windows:nsis": "node scripts/release/build-windows.mjs nsis",
    "release:windows:msi": "node scripts/release/build-windows.mjs msi",
    "release:windows:all": "node scripts/release/build-windows.mjs all",
    "release:windows:manifest": "node scripts/release/build-windows.mjs manifest"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fflate": "^0.8.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  }
}
