{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ogram private",
  "version": "0.1.1",
  "identifier": "ch.ogram.private",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run app:dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run app:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ogram private",
        "center": true,
        "width": 1120,
        "height": 820,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Parsing Sarl",
    "homepage": "https://self-tech-labs.github.io/privacy-filter/",
    "copyright": "Copyright (c) 2026 Parsing Sarl. Released under the MIT License.",
    "category": "Business",
    "shortDescription": "Privacy Filter by ogram is a local-first Mac redaction tool for privacy-sensitive prompt preparation.",
    "longDescription": "Privacy Filter by ogram helps Swiss law firms, medical practices, and other privacy-sensitive professionals redact working material locally on macOS before moving a cleaned draft into frontier-model workflows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "dmg": {
        "windowSize": {
          "width": 820,
          "height": 540
        },
        "appPosition": {
          "x": 220,
          "y": 280
        },
        "applicationFolderPosition": {
          "x": 600,
          "y": 280
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEODlGRjU4NEU5OTZGMUUKUldRZWI1bE9XUCtKSFlpMTB1WUJDQTZCVklNWUZOc1RzNkFFMmp6NjVIYjRRWFB2U2YzY1M0NzUK",
      "endpoints": [
        "https://downloads.ogram.ch/private/latest.json"
      ]
    }
  }
}
