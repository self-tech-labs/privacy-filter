{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-progress-bar",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPCACHE/transformers-cache"
        },
        {
          "path": "$APPCACHE/transformers-cache/*"
        },
        {
          "path": "$APPCACHE/transformers-cache/**/*"
        }
      ]
    }
  ]
}
